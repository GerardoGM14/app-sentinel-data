# Copiar como .env.prod (no se sube al repositorio) y completar.

# Nombre público del servidor. Sin dominio propio sirve <IP-con-guiones>.sslip.io,
# por ejemplo 203-0-113-10.sslip.io
DOMINIO=

# Secretos: generar cada uno con  openssl rand -hex 32
DB_ROOT_PASSWORD=
DB_PASSWORD=
SESSION_SECRET=
JWT_SECRET=

# SMTP real (Brevo: smtp-relay.brevo.com, puerto 587 o 2525, usuario y clave SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SentinelData <remitente-verificado@ejemplo.cl>"

# true: carga los datos de demostración. Las contraseñas de las cuentas de
# prueba están en el README, así que no usar true con datos reales.
SEED_DEMO=true
