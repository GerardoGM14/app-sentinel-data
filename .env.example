# ---------------------------------------------------------------
# SentinelData - variables de entorno
# Copia este archivo como .env y ajusta los valores.
# Con Docker Compose no es necesario: los valores de desarrollo
# ya están en docker-compose.yml.
# ---------------------------------------------------------------

NODE_ENV=development
PORT=3000
# URL pública con la que se arman los enlaces de los correos
APP_URL=http://localhost:3000
TZ=America/Santiago

# Secreto para firmar la cookie de sesión (cadena larga y aleatoria)
SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
# Minutos de inactividad antes de expirar la sesión
SESSION_MINUTES=30
# Detrás de un proxy HTTPS (Railway, Render, Nginx) poner 1
TRUST_PROXY=0

# API REST: secreto para firmar los JWT (distinto de SESSION_SECRET)
JWT_SECRET=cambia-esto-por-otra-cadena-larga-y-aleatoria
# Vigencia de los tokens de acceso, en minutos
JWT_MINUTES=15
# Solicitudes a /api/v1 por IP cada 15 min
API_RATE_LIMIT=300

# Base de datos MySQL 8.4
DB_HOST=localhost
DB_PORT=3306
DB_USER=sentinel
DB_PASSWORD=sentinel_dev
DB_NAME=sentinel

# Carga los datos de demostración si la base está vacía (true/false)
SEED_DEMO=true

# Correo (Mailpit en desarrollo; Gmail/Brevo en producción)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SentinelData <no-reply@translogix.cl>"

# Seguridad de autenticación
BCRYPT_COST=12
MAX_INTENTOS=5
BLOQUEO_MINUTOS=15
# Máximo de envíos a /login, /registro y /recuperar por IP cada 15 min
AUTH_RATE_LIMIT=30

# Horario laboral para la regla FUERA_HORARIO (hora local, 0-23)
HORARIO_INICIO=7
HORARIO_FIN=20
